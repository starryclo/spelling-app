# Claude AI API 키 (맞춤법/띄어쓰기/외래어 검사용)
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 국립국어원 표준국어대사전 오픈 API 키 (단어 검색용)
# https://stdict.korean.go.kr/openapi/openApiInfo.do 에서 발급
KOREAN_API_KEY=...

# (선택) 우리말샘 오픈 API 키
# 표준국어대사전과 별도 키가 필요합니다. https://opendict.korean.go.kr/service/openApiInfo
# 미설정 시 우리말샘 검색은 KOREAN_API_KEY 를 사용합니다.
WOORIMALSAM_API_KEY=
